#!/bin/sh
# The commit gate: CI's rustfmt, clippy, file-length, allowance, casing and README jobs
# (.github/workflows/ci.yml), run before each commit so a commit cannot fail them, then the CRAP
# gate (scripts/crap.sh: the tests under coverage, no function newly above the threshold). Enable
# it once per clone (worktrees share the setting):
#
#     git config core.hooksPath .githooks
#
# It checks the working tree, not only what is staged. It honours CARGO_TARGET_DIR. Skip it
# once with `git commit --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
cargo fmt --all --check
cargo clippy --locked --workspace --all-targets -- -D warnings
scripts/file_size.py
scripts/lint_allows.py
scripts/c_case.py
scripts/readmes.py crates/engine/genie-core/src --check
scripts/effects.py crates/engine/genie-core/src --check
scripts/schedule.py crates/engine/genie-core/src --check
scripts/crap.sh
