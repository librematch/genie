    len | std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x) | doc "How many it holds.",
  },
  GroundOffset | doc "A displacement on the map's ground, x and y in tiles: a step of a walk or a search (a\nspiral's, a landing walk's, a pather's ray), a direction of a table, an annex's place off its\nbuilding's, a volley missile's scatter." = Array (Number),
  GroupTuning | doc "The `group` port's tuning values." = {
    aside_timer | Number | doc "The timer of the move aside after too many failures (`DAT_142eb5690`).\n\n`group::ASIDE_TIMER`: 0.1 in build 158041.",
    box_sides | Number | doc "A box's perimeter is its side times this (`DAT_142eb0f48`).\n\n`group::BOX_SIDES`: 4 in build 158041.",
    box_side_share | Number | doc "A box too small for its units grows to this share of their length (`DAT_142eb880c`).\n\n`group::BOX_SIDE_SHARE`: 0.25 in build 158041.",
    catch_up | Number | doc "The catching up's share of the top speed (`DAT_142ed66b4`).\n\n`group::CATCH_UP`: 1.2 in build 158041.",
    catch_up_span | Number | doc "The spacing of the points of a ring: the unit's line of sight and this (`DAT_142eb1c98`, the constant the group port's catch-up span also reads).\n\n`group::CATCH_UP_SPAN`: 3 in build 158041.",
    chasing_slack | Number | doc "What a group's attack adds to the range against a moving target that outranges it (`DAT_142eb5be8`).\n\n`group::CHASING_SLACK`: -2 in build 158041.",
