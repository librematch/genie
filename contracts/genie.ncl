    count | std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767) | doc "The third.",
  }), 'Tech ({
    party | Party | doc "The block's players.",
    tech | TechId | optional | doc "The first argument (a negative one is none).",
    mode | ModifyMode | doc "The second.",
    amount | Number | doc "The fourth.",
    location | ModifyLocation | doc "The third.",
  }), 'Objects (ObjectsKind), 'TechCost ({
    tech | TechId | optional | doc "The first argument (a negative one is none).",
