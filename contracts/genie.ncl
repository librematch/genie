  },
  ClassId | doc "A master's class (`+0x410`, the `.dat`'s `unit_class`), 0 or more, or −1 for a master that has\nnone ([`ClassId::of_master`]). The `.dat` holds classes the engine does not tell apart, and\nthe ones it does are roles of the build layer (`Roles::of_class`, FD-046-D03), so the class\nis a newtype, not an enum: any class the data holds is a class." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  ClassRoles = [| 'ALWAYS_SPARED, 'ARCHERY, 'ARCHERY_CANNON, 'ARTIFACT, 'ATTACK_MOVE_ATTACKS, 'BIRD, 'BOARDING_SHIP, 'BOAT, 'BOTH_LISTS_TARGET, 'BUILDING, 'CAPTURE_IGNORED, 'CATEGORY_LIST_TARGET, 'CAVALRY, 'CAVALRY_ARCHER, 'CAVALRY_CANNON, 'CAVALRY_RAIDER, 'CIVILIAN_COUNT, 'CLIFF, 'CLOSEST_LIVESTOCK, 'CLOSEST_PASTURE, 'CONTROLLED_ANIMAL, 'DAMAGE_BY_STORAGE, 'DAMAGE_BY_STORAGE_DEAD, 'DEATH_BLAST, 'DEEP_SEA_FISH, 'DOMESTIC_ANIMAL, 'ELEPHANT_ARCHER, 'FARM, 'FISHING_SHIP, 'FLAG, 'FORAGE_BUSH, 'FOUNDATION_TERRAIN, 'GAIA_KEPT, 'GATE, 'GOLD_FISH, 'GOLD_MINE, 'HEALER, 'INFANTRY, 'KEEPS_UNIT_AI_FROM, 'KEEPS_UNIT_AI_TO, 'KEPT_BY_MEMBERS, 'KING, 'LAND_MINE, 'LEAST_HIT, 'LION_TARGET, 'LIVESTOCK, 'MILITARY_COUNT, 'MILITARY_KEY, 'MISCELLANEOUS, 'MISC_BUILDING, 'MONK, 'MONK_WITH_RELIC, 'NEVER_EXHAUSTED, 'NEVER_PENDING, 'NOT_ANY, 'NOT_ATTACK_TARGET, 'NO_ATTACK, 'NO_ATTACK_UNLESS_HERO, 'OCEAN_FISH, 'ORE_MINE, 'PACKED_ATTACKS_NOTHING, 'PACKED_TREBUCHET, 'PACKS_TO_MOVE, 'PEACEFUL, 'PETARD, 'PHALANX, 'PIKEMAN, 'PREDATOR, 'PREDATOR_TARGET, 'PREY, 'PRIORITY_3_TARGET, 'RAIDER, 'RAM_TARGET, 'RELIC, 'REPAIRED_AS_UNIT, 'REPAIRED_AT_SHORE, 'REPAIR_COSTED, 'RESOURCE_PILE, 'SALVAGE_PILE, 'SCORPION, 'SCOUT_CAVALRY, 'SELF_ALERTING, 'SHARES_UNIT_AI, 'SHORE_FISH, 'SIEGE, 'SKIPS_SIEGE_CHECK, 'SPEARMAN, 'STONE_MINE, 'STRUCK_BUILDING, 'TERRAIN, 'TOWER, 'TRADER, 'TRADE_BOAT, 'TRADE_CART, 'TRANSPORT, 'TRANSPORT_CATEGORY, 'TREBUCHET_TARGET, 'TREE, 'TREE_STUMP, 'TWO_HANDED_SWORDSMAN, 'UNDELETABLE, 'UNPACKED_TREBUCHET, 'UNWATCHED, 'VILLAGER, 'WALL, 'WALL_BUILDER, 'WARSHIP, 'WAR_ELEPHANT, 'WHOLE_GARRISON_SHARE, 'WIDE_REACH |],
  ClassSlots | doc "The class ids the engine names, one field each." = {
    building | ClassId | doc "Buildings, which a unit's garrison task names.",
    villager | ClassId | doc "Villagers (`-0xea8` raw).",
    farm | ClassId | doc "Farms and a pasture's livestock (decoded 49, `0x31`).",
    livestock | ClassId | doc "Livestock (decoded 58, `0x3a`, `-0xe72` raw), which goes to Gaia when killed.",
  },
  CombatAbility | doc "The set's flag names joined by ` | `, unnamed bits as one hexadecimal number (`0x10`)." = String,
  CombatLevel | doc "A master's combat level (`+0x62c`, the `.dat`'s `combat_level`), every byte the data or an\neffect leaves kept. Named by the masters of build 158041's `.dat` that carry each value." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  CombatPart | doc "The combat layer of a master of type 50 and up but 90 (`RGE_Master_Combat_Object`,\n`+0x7f8`..`+0x87f`; the `.dat`'s type-50 section): its attack, its armor, its blast and the\nvalues its interface shows. A missile (60), a combat unit (70) and a building (80) hold it.\n\nA combat master's attack reads its standing sprite (`+0x470`, the base's), its attack sprite\n(`+0x7f8`, `fight_sprite_id`), a second attack sprite (`+0x878`, the `.dat`'s\n`attack_graphic2`), `missile_id`, `fire_missile_at_frame`, `interrupt_frame`,\n`base_hit_chance`, `speed_of_attack` (the reload time) and its weapons (class, amount); and\nthe sprite it waits with between swings (`+0x910`, the creatable layer's). A hit on an object\nof this master reads (`FUN_141082530`) its armor classes (class, amount; `+0x808`, count\n`+0x802`), its base armor for a class it does not list (`+0x800`), `bonus_damage_resistance`\n(`+0x824`), `combat_ability` (`+0x840`), `damage_reflection` (`+0x864`),\n`friendly_fire_damage` (`+0x868`) and the base's `area_effect_object_level` (`+0x62b`, the\nblasts that reach it), with the creatable layer's `invulnerability_level` (`+0x930`: a hit\npoint floor, `FUN_141202a80`), `special_attack_flag` (`+0x8d8`) and special graphic\n(`+0x8e8`); an attacker of it reads `area_effect_range` (`+0x82c`), `area_effect_level`\n(`+0x830`), `area_damage` (`+0x834`) and the creatable layer's `max_charge` (`+0x918`) and\n`charge_target` (`+0x924`)." = {
    weapon_range | Distance | doc "`weapon_range` (`+0x828`, object slot 0x230).",
    min_range | Distance | doc "`minimum_weapon_range` (`+0x850`, slot 0x240).",
    terrain_bonus | RestrictionField | doc "`+0x820`, the `.dat`'s `defense_terrain_bonus` (a terrain restriction): a completed\nbuilding keeps to restore a tile's terrain whose value in it is neither 0 nor 1.",
    base_armor | DamageAmount | doc "`+0x800`: its base armor, for a class its armor classes do not list.",
    armors | Array (ClassAmount) | doc "Its armor classes (class, amount; `+0x808`, count `+0x802`).",
    resistance | DamageShare | doc "`bonus_damage_resistance` (`+0x824`).",
    combat_ability | CombatAbility | doc "`combat_ability` (`+0x840`).",
    reflection | DamageShare | doc "`damage_reflection` (`+0x864`).",
    friendly_fire | DamageShare | doc "`friendly_fire_damage` (`+0x868`).",
    area_effect | Distance | doc "`area_effect_range` (`+0x82c`): its blast's radius.",
    blast_level | BlastLevel | doc "`area_effect_level` (`+0x830`).",
    area_damage | DamageShare | doc "`area_damage` (`+0x834`).",
    attack_sprite | SpriteId | optional | doc "Its attack sprite (`+0x7f8`, `fight_sprite_id`).",
    attack_sprite2 | SpriteId | optional | doc "A second attack sprite (`+0x878`).",
    missile | MasterField | doc "`missile_id`, −1 for none: every short the effects leave in it is kept.",
    fire_frame | Frame | doc "`fire_missile_at_frame`.",
    interrupt_frame | Frame | doc "`interrupt_frame`.",
    hit_chance | HitChance | doc "`base_hit_chance`.",
    reload | Seconds | doc "`speed_of_attack`: the reload time.",
    weapons | Array (ClassAmount) | doc "Its weapons (class, amount).",
    weapon_offset | Offset | doc "Where its missile starts from its place, turned by its facing (`+0x844`..`+0x84c`,\n`weapon_offset`), and how far a missed missile strays per tile of the way\n(`missed_missile_spread`, `+0x860`).",
    missed_spread | MissSpread | doc "How far a missed missile strays per tile of the way (`missed_missile_spread`, `+0x860`).",
    garrison_firepower | Firepower | doc "`garrison_firepower` (`+0x870`): what a unit adds to the volleys of a building it is\ninside; one at most 0 adds its magnitude.",
    shown | Shown | doc "`+0x856`, `+0x858` and `+0x854`: the attack, range and melee armor a combat master shows\n(`orig_weapon`, `orig_weapon_range`, `orig_armor`).",
  },
  ConversionAdjust | doc "A master's `mMinConversionTimeAdj`, `mMaxConversionTimeAdj` and `mConversionChanceAdj`\n(`+0x934`, `+0x938`, `+0x93c`): what its effects add to a conversion's shortest and longest\ntime and to its chance." = {
    min_time | Number | doc "`mMinConversionTimeAdj` (`+0x934`, \"Min Conversion Time Modifier\").",
    max_time | Number | doc "`mMaxConversionTimeAdj` (`+0x938`, \"Max Conversion Time Modifier\").",
    chance | Number | doc "`mConversionChanceAdj` (`+0x93c`, \"Conversion Chance Modifier\").",
  },
  Cost | doc "One cost entry of a technology in the `.dat`." = {
    attribute | AttributeId | optional | doc "The attribute it takes, none for −1.",
    amount | CostAmount | doc "How much.",
    paid | CostPaid | doc "0 not paid, 1 paid from the player's attribute, 2 from the building (`FUN_141204310`).",
  },
  CostAmount | doc "A cost's whole amount (a short): a master's cost slot (`+0x880`), a technology's `.dat`\ncost, a research's cost adjustment (`+0x6`) and a cost override's amount (`+0x42`). The\narithmetic on it is the game's 16-bit one." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  CostEdit | doc "What a cost command does with the cost slot of its resource (`FUN_1415c1f70`'s `how`, the\namount as CVTTSS2SI gives it)." = [| 'Remove, 'Add |],
  CostPaid | doc "How a technology's cost entry is paid (the `.dat`'s paid flag): 0 not at all, 1 from the\nplayer's attribute, 2 from the building (`FUN_141204310`). Every byte is kept; any but 0 is\npaid." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  CostSlot | doc "One of a master's cost slots (`+0x880`: the attribute, the amount and the paid flag, six\nbytes): the `.dat`'s `resource_costs` and the save's `build_inventory` entry in its place. An\nempty slot holds attribute −1 (none); the readers pass over it, and the slots after it keep\ntheir places (the queue's gold slot, the upgrade effect's removal and addition)." = {
    attribute | AttributeId | optional | doc "The attribute it costs, none for an empty slot (−1).",
    amount | CostAmount | doc "How much.",
    paid | Bool | doc "The paid flag (`+0x884`): the payment takes it; an unpaid entry (the population) is\nonly tested.",
  },
  CostUnits | doc "The masters a cost command changes (`FUN_1415c1f70`'s `unit`): a master by its id, or every\nmaster of a class (a `unit` of 900 to 999 names class `unit − 900`)." = [| 'Master (MasterId), 'Class (ClassId) |],
  CreatablePart | doc "The creatable layer of a master of type 70 or 80 (`TRIBE_Master_Combat_Object`,\n`+0x880`..`+0x94f`; the `.dat`'s creatable section): its costs, train locations, volleys, charge\nand the values its interface shows." = {
    cost | Array (CostSlot) | doc "`+0x880`, the cost slots in their places (an empty one among them).",
    build_time | WholeSeconds | doc "The build time: the first train location's train time, 0 without one.",
    trained_at | Array (MasterId) | doc "The train locations' ids (`+0x898`, each entry's first short): the units that build a\nbuilding, the buildings that train a unit (`FUN_141263610`).",
    charge_kind | ChargeKind | doc "`charge_type` (`+0x922`): 6 and 7 add `charge_event` (`+0x920`) to the range against some\ntargets (slot 0x2f8).",
    formation_category | FormationClass | doc "`+0x8bc`, `mFormationCategory`: 0 (villagers) keeps a unit out of the groups an order's\nsplitter forms (`FUN_140fd76d0`).",
    hero_flag | HeroFlags | doc "`+0x8d9`, `hero_flag`: a combat master it grants\n[`HeroFlags::PROTECTED_FORMATION`] joins a group's fifth sub-formation (`FUN_141011300`).",
    spacing_modifier | SpacingModifier | doc "`+0x8b8`, `mSpacingModifier`: with the radius on x the unit's radius in a group's\nformation (`FUN_141025920`). The player's masters copy it from the data file's.",
    invulnerability | InvulnerabilityLevel | doc "`invulnerability_level` (`+0x930`): a hit point floor.",
    attack_priority | AttackPriority | doc "`attack_priority` (`+0x92c`, `FUN_141202220`): 3 attacks only the classes of\n`FUN_140fddf10`.",
    special_attack | SpecialAttack | doc "`special_attack_flag` (`+0x8d8`).",
    special_sprite | SpriteId | optional | doc "The special graphic's sprite (the `.dat`'s `special_graphic`), −1 for none: a herder\nleading livestock shows it. Whether the master has one (`+0x8e8`, the sprite the loader\nlooks up for it) is whether it is set.",
    max_charge | Charge | doc "`max_charge` (`+0x918`).",
    charge_target | ChargeTarget | doc "`charge_target` (`+0x924`).",
    idle_attack_sprite | SpriteId | optional | doc "The sprite it waits with between swings (`+0x910`, −1 for none).",
    volley_fire | Firepower | doc "`volley_fire_amount` (`+0x8c0`, the `.dat`'s total projectiles): a new object's missiles\nper volley (`+0xa00`).",
    max_volley | MissileCount | doc "`max_attacks_in_volley` (`+0x8c4`, the `.dat`'s max total projectiles).",
    volley_spread | VolleySpread | doc "`volley_x_spread`, `volley_y_spread` and `volley_start_spread_adjustment` (`+0x8c8`..\n`+0x8d0`, the `.dat`'s projectile spawning area): how far a volley's missiles scatter.",
    volley_missile | MasterId | optional | doc "`volley_missile_id` (`+0x8d4`, the `.dat`'s secondary projectile), None for −1.",
    charge_projectile | MasterId | optional | doc "`mChargeProjectileUnit` (`+0x928`), None for −1.",
    train_locations | Array (TrainLocation) | doc "The train locations (`+0x898`, 12 bytes each; the save's `train_location`), which\n[`Self::trained_at`] and [`Self::build_time`] follow.",
    train_location_entry | TrainLocationEntry | doc "`+0x940`, `mTrainLocationEntryMod`: the train location the attributes 42, 43, 58 and 101\nchange.",
    regeneration | Regeneration | doc "`+0x8b4`, `regeneration_rate`.",
    recharge_rate | ChargeRate | doc "`+0x91c`, `mRechargeRate`.",
    charge_event | ChargeEvent | doc "`+0x920`, `mChargeEvent`.",
    conversion | ConversionAdjust | doc "`+0x934`, `+0x938`, `+0x93c`: `mMinConversionTimeAdj`, `mMaxConversionTimeAdj`,\n`mConversionChanceAdj`.",
    hero_glow_sprite | SpriteId | optional | doc "`+0x908`, the hero glow sprite (−1 for none).",
    garrison_sprite | SpriteId | optional | doc "`+0x8f0`, the garrison sprite (−1 for none).",
    pierce_armor_shown | DamageAmount | doc "`+0x8b0`, `orig_pierce_armor`: the pierce armor the master shows.",
  },
  DamageAmount | doc "An attack's or an armor's amount: the `.dat`'s `amount` of an attack or armor entry, the base\narmor (`+0x800`), the shown attack and armors, and an object's armor powerups and the armor\nits charge's hits took off it. A signed short, which the armor slots add and subtract\nwrapping and the damage reads as a float." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  DamageClass | doc "An armor or attack class (the `.dat`'s `class` of an armor or attack entry; an attribute\neffect's amount's high byte): a hit's weapon of a class meets the victim's armor of the same\nclass. The simulation's tests name melee (4), pierce (3) and the classes the garrison's\nfirepower sums (31, 38); every other value is a class the tests do not tell apart." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  DamageGraphic | doc "One damage sprite of a master (`+0x638`'s entries; the save's `damage_sprite`). A new entry\n(the default) has no sprite and zero bytes (the game zeroes its 16 bytes)." = {
    sprite | SpriteId | optional | doc "`+0x0`, the sprite (`tempId`, −1 for none).",
    percent | HpPercent | doc "`+0x8`, `damage_percent`.",
    apply_mode | DamageSpriteMode | doc "`+0x9`, the `flag` (the `.dat`'s `apply_mode`).",
  },
  DamageGraphicEntry | doc "The damage sprite entry the attributes 91, 156 and 157 change (`+0x731`,\n`mDamageSpriteEntryMod`, a byte): an index into the damage sprites, 0xff with none left." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  DamageShare | doc "A share of a damage (a float the `.dat` holds and the effects set, add to and scale): the\nbonus damage a master resists (`bonus_damage_resistance`, `+0x824`), the damage it reflects\non its attacker (`damage_reflection`, `+0x864`), its own side takes of its blasts\n(`friendly_fire_damage`, `+0x868`) and its blast deals (`area_damage`, `+0x834`). Each\noperator is the one `f32` operation the game does; every value is kept." = Number,
  DamageSpriteMode | doc "How a damage sprite is applied (its `flag`, `+0x9`, the `.dat`'s `apply_mode`): placed,\nscattered (two Object-stream draws) or shown as the object's sprite." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  DamageTuning | doc "The `damage` port's tuning values." = {
    blast_range | Number | doc "A melee attacker (weapon range below 0.99, `DAT_142eb569c`) with an area effect tramples: its blast goes about itself (`FUN_1412115e0`).\n\n`damage::BLAST_RANGE`: 0.99 in build 158041.",
    cone | Number | doc "A cone blast (its level's bit 7) reaches objects within half a facet of where its attacker faces (`DAT_142e7f384`, `DAT_142eb6e58`), or within 1.67 facets (`DAT_142f4fea8`) for a wide one (bit 5).\n\n`damage::CONE`: 0.5 in build 158041.",
    facing | Number | doc "A special attack and a retaliation need their attacker within 1.2 facets of where the target faces (`DAT_142ed66b4`, `DAT_142eb99e4`); the special attack takes the hit's damage to 0.66 (`DAT_142f3855c`); a retaliation answers attackers of a weapon range below 0.2 (`DAT_142eae8d0`), four times over an attacker whose charge is ready (`DAT_142eb0f48`).\n\n`damage::FACING`: 1.2 in build 158041.",
    higher | Number | doc "Elevation: a higher attacker hits at 1.25 (`DAT_142eb56a8`), a lower one at 0.75 (`DAT_142e7f388`), each plus its player's and the target's player's attributes (211/272, 212/273).\n\n`damage::HIGHER`: 1.25 in build 158041.",
    least_class_hit | Number | doc "The least hit of the attacker classes `LEAST_HIT_CLASSES` under the game's setting `+0x680` at 1 (`DAT_142eb5690`, read into `XMM6` at `0x1411ceea4`).\n\n`damage::LEAST_CLASS_HIT`: 0.1 in build 158041.",
    lower | Number | doc "Elevation: a higher attacker hits at 1.25 (`DAT_142eb56a8`), a lower one at 0.75 (`DAT_142e7f388`), each plus its player's and the target's player's attributes (211/272, 212/273).\n\n`damage::LOWER`: 0.75 in build 158041.",
    minus_cone | Number | doc "A cone blast (its level's bit 7) reaches objects within half a facet of where its attacker faces (`DAT_142e7f384`, `DAT_142eb6e58`), or within 1.67 facets (`DAT_142f4fea8`) for a wide one (bit 5).\n\n`damage::MINUS_CONE`: -0.5 in build 158041.",
    minus_facing | Number | doc "A special attack and a retaliation need their attacker within 1.2 facets of where the target faces (`DAT_142ed66b4`, `DAT_142eb99e4`); the special attack takes the hit's damage to 0.66 (`DAT_142f3855c`); a retaliation answers attackers of a weapon range below 0.2 (`DAT_142eae8d0`), four times over an attacker whose charge is ready (`DAT_142eb0f48`).\n\n`damage::MINUS_FACING`: -1.2 in build 158041.",
    relic_boost | Number | doc "A building's hits with a specific relic inside (`DAT_142ed66b4`, 1.2), and with any relic (`DAT_142e86c14`, 1.1), `building_elevation_factor`.\n\n`damage::RELIC_BOOST`: 1.1 in build 158041.",
    retaliation_range | Number | doc "A special attack and a retaliation need their attacker within 1.2 facets of where the target faces (`DAT_142ed66b4`, `DAT_142eb99e4`); the special attack takes the hit's damage to 0.66 (`DAT_142f3855c`); a retaliation answers attackers of a weapon range below 0.2 (`DAT_142eae8d0`), four times over an attacker whose charge is ready (`DAT_142eb0f48`).\n\n`damage::RETALIATION_RANGE`: 0.2 in build 158041.",
    retaliation_scale | Number | doc "A special attack and a retaliation need their attacker within 1.2 facets of where the target faces (`DAT_142ed66b4`, `DAT_142eb99e4`); the special attack takes the hit's damage to 0.66 (`DAT_142f3855c`); a retaliation answers attackers of a weapon range below 0.2 (`DAT_142eae8d0`), four times over an attacker whose charge is ready (`DAT_142eb0f48`).\n\n`damage::RETALIATION_SCALE`: 4 in build 158041.",
    special | Number | doc "A special attack and a retaliation need their attacker within 1.2 facets of where the target faces (`DAT_142ed66b4`, `DAT_142eb99e4`); the special attack takes the hit's damage to 0.66 (`DAT_142f3855c`); a retaliation answers attackers of a weapon range below 0.2 (`DAT_142eae8d0`), four times over an attacker whose charge is ready (`DAT_142eb0f48`).\n\n`damage::SPECIAL`: 0.66 in build 158041.",
    specific_relic_boost | Number | doc "A building's hits with a specific relic inside (`DAT_142ed66b4`, 1.2), and with any relic (`DAT_142e86c14`, 1.1), `building_elevation_factor`.\n\n`damage::SPECIFIC_RELIC_BOOST`: 1.2 in build 158041.",
    wide_cone | Number | doc "A cone blast (its level's bit 7) reaches objects within half a facet of where its attacker faces (`DAT_142e7f384`, `DAT_142eb6e58`), or within 1.67 facets (`DAT_142f4fea8`) for a wide one (bit 5).\n\n`damage::WIDE_CONE`: 1.67 in build 158041.",
  },
  DisabledTech | doc "The technology a disable command (`'f'`) names: its amount as CVTTSS2SI gives it. −1 disables\nnone; the shared kind's test (`FUN_1413d1020`) reads the whole number, the disabling\n(`FUN_1413cdb00`) its low 16 bits, a negative one every technology." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0),
  Distance | doc "A distance on the map in tiles as the game's `f32` holds it: a master's range, minimum range,\nwork range, search radius and line of sight, a reach, a gap between two footprints, a group's\nranges. Each operator is the one `f32` operation the game does, in its order; a comparison is\n`f32`'s (a NaN compares false)." = Number,
  DropSite | doc "One entry of the drop-site table (`DAT_143cc2948`, the game's `dropsites.json`): the building,\nthe workers it serves (their class, −1 any, or else a list of their masters), the civs it is\nfor (empty: all) and the resource kinds it takes." = {
    building | MasterId | doc "The building's master.",
    worker_class | ClassId | optional | doc "The class of the units that drop there (−1 any).",
    workers | Array (MasterId) | doc "The unit masters that drop there (empty: all).",
    civs | Array (CivId) | doc "The civs it is for (empty: all).",
    auto_work | Bool | doc "`+8`, `auto_work` (1 when the key is missing): a builder whose building completes looks\nfor more work around it (`FUN_1415cc4e0`).",
    targets | Array (DropTarget) | doc "`+0x50`, `target_list`: the objects whose resources it takes, in the file's order.",
    resource_types | Array (AttributeId) | doc "`+0x30`, `update_ai_resource_types`: the basic resources (0 to 3) it takes, which the\ntable's search by resource reads (`table_drop_buildings`).",
    livestock | Bool | doc "The entry has `accepts_livestock` (`FUN_140fdf480` keeps the key's presence): its building\nis one of the drop sites a hunted livestock is led to (`DAT_143f157f0`, in table order).",
  },
  DropTarget | doc "A drop site's target (`FUN_140fdf480`'s record of 0x14 bytes; each −1 when its key is missing)." = {
    class | ClassId | doc "`object_group`: the class of the objects.",
    workers | WorkerCount | doc "`worker_num`: the most workers such an object may have.",
    state | ObjectState | optional | doc "`object_state`: the state such an object must be in (none for −1, any).",
    attribute | AttributeId | optional | doc "`attribute_type`: the resource it gives, none for −1.",
  },
  EffectCommand | doc "One command of an effect, by its kind. The base's kinds name the [`Party`] they reach." = [| 'Attribute ({
    party | Party | doc "The block's players.",
    change | Change | doc "Kind 0 sets, 4 adds, 5 multiplies.",
    master | MasterId | optional | doc "The first argument (a negative one is none).",
    class | ClassId | optional | doc "The second argument.",
    attribute | MasterAttribute | doc "The third argument's low byte.",
    amount | Number | doc "The fourth.",
  }), 'Costs ({
    party | Party | doc "The block's players.",
    units | CostUnits | optional | doc "The masters it names (none for a negative argument).",
    attribute | MasterAttribute | doc "The cost attribute.",
    edit | CostEdit | optional | doc "The amount as CVTTSS2SI gives it (none for any but −2 and −1).",
  }), 'Resource ({
    party | Party | doc "The block's players.",
    attribute | AttributeId | optional | doc "The first argument (a negative one is none: nothing changes).",
    change | ResourceChange | doc "The second argument's low byte.",
    scale | AttributeId | optional | doc "The third argument (a negative one is none: the amount as it is).",
    amount | Number | doc "The fourth.",
  }), 'ResourceMultiply ({
    party | Party | doc "The block's players.",
    attribute | AttributeId | optional | doc "The first argument (a negative one is none: nothing changes).",
    amount | Number | doc "The fourth.",
  }), 'Enable ({
    party | Party | doc "The block's players.",
