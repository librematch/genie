  InteractionMode | doc "A master's interaction mode (`select_level`, `+0x62d`; the `.dat`'s `interaction_mode`,\nopenage's names): whether a player may select its objects and give them orders. The simulation\nonly keeps it; every byte is kept." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  InterfaceKind | doc "A master's interface kind (`unit_level`, `+0x62f`; the `.dat`'s `interface_kind`, openage's\nnames): the command panel a selected object of it shows. The simulation only keeps it; every\nbyte is kept." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  InvulnerabilityLevel | doc "A master's invulnerability level (`invulnerability_level`, `+0x930`, a float the effects set,\nadd to and scale): above 0 a share of its master's hit points, below 0 their number, that a\nhit leaves it. Every value is kept." = Number,
  LineEntry | doc "A master's entry of table 1 (12 bytes)." = {
    next | MasterId | optional | doc "`+0`: the master after it in its chain (none for the last, the game's −1).",
    line | LineId | optional | doc "`+4`: its line (none, the game's −1).",
    building | Bool | doc "`+8`: its line's `Building` flag.",
  },
  LineId | doc "A unit line's id (`LineID`, an int): −399 and the 199 after it index table 2." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0),
  Linked | doc "How a group of the game's `linkedTechs.json` links its technologies: the `+4` byte of the\nrecord the game settings' table (`FUN_140f39f40`) holds for each of them." = [| 'MutuallyExclusive, 'Toggleable, 'Cycle |],
  LocationButton | doc "A train or research location's button (`buttonLocationID`, a byte of the `.dat` or of a\ntechnology change): 0 for none. Every byte is kept." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  LongPathTuning | doc "The `long_path` port's tuning values." = {
    edge_gap | Number | doc "A target's footprint ends this short of its far edges (`DAT_142eb99cc`).\n\n`long_path::EDGE_GAP`: 0.01 in build 158041.",
    reached | Number | doc "The goal counts as reached within this many tiles, and a range above it ends the search before it starts when the goal lies within the range (`DAT_14330eb8c`).\n\n`long_path::REACHED`: 1 in build 158041.",
  },
  MarketTuning | doc "The `market` port's tuning values." = {
    food_start | Number | doc "Food's price after its net trades came back to 0 (`DAT_142f03164`).\n\n`market::FOOD_START`: 1.15 in build 158041.",
    least_cost | Number | doc "A purchase costs at least this (`DAT_142f66f34`).\n\n`market::LEAST_COST`: 21 in build 158041.",
    ore_start | Number | doc "Ore's price after its net trades came back to 0 (`DAT_14330eb8c`).\n\n`market::ORE_START`: 1 in build 158041.",
    stone_start | Number | doc "Stone's price after its net trades came back to 0 (`DAT_142f0703c`).\n\n`market::STONE_START`: 1.3 in build 158041.",
    swing | Number | doc "A trade's growth of the swing (`DAT_142e8c150`).\n\n`market::SWING`: 2 in build 158041.",
    wood_start | Number | doc "Wood's price after its net trades came back to 0 (`DAT_14330eb8c`).\n\n`market::WOOD_START`: 1 in build 158041.",
  },
  Master | doc "The master values the task finder and the work command read." = {
    id | MasterId | doc "The master's id.",
    kind | MasterKind | doc "The master's type (`+0x8`): 70 for a combat unit, 80 (`'P'`) for a building.",
    copy_id | MasterId | optional | doc "`+0x158`, the `.dat`'s `copy_id`: the master a garrison order asks a building about\n(`FUN_141621220`).",
    base_id | MasterId | optional | doc "`+0x260`, the `.dat`'s `base_id` (the master load `FUN_1411319f0` turns 768 into 420 and\n770 into 691): the master whose availability says whether the player can make this one\n(`FUN_141663f80`, `genie_core::world::World::can_make`); an upgrade's copy keeps it.",
    class | ClassId | doc "`+0x410`.",
    action | ActionPart | optional | doc "The action layer (types 40 and up but 90, `+0x790`..`+0x7b9`): tasks, default task, work\nrate, search radius, drop sites; None for other masters.",
    radius | Footprint | doc "`radius_x`, `radius_y` (`+0x5d8`, `+0x5dc`).",
    tall | Bool | doc "`radius_z` (`+0x5e0`) is above 0: its objects count as tall on their tiles.",
    height | Distance | doc "`radius_z` (`+0x5e0`): how high a missile may pass over its objects and hit them\n(`FUN_14113f740`).",
    line_of_sight | Distance | doc "`line_of_sight` (`+0x5d0`).",
    terrain_restriction | RestrictionId | optional | doc "`+0x606`, its terrain restriction (the save's `terrain_restriction_mask_id`; −1 for none),\nwhich a placement test reads.",
    obstruction_kind | ObstructionKind | doc "`obstruction_type` (`+0x651`) and `can_be_built_on` (`+0x5e9`).",
    buildable_on | BuildableOn | doc "`can_be_built_on` (`+0x5e9`): a new building deletes an object of it off its footprint.",
    obstruction_class | ObstructionClass | doc "`obstruction_class` (`+0x652`).",
    object_flags | ObjectFlags | doc "`object_flags` (`+0x654`): its traits and the trait piece ([`ObjectFlags`]).",
    combat_level | CombatLevel | doc "The `.dat`'s `combat_level` (`+0x62c`).",
    creatable | CreatablePart | optional | doc "The creatable layer (types 70 and 80, `+0x880`..`+0x94f`): costs, train locations, volleys,\ncharge; None for other masters.",
    hit_points | MasterHitPoints | doc "The hit points (`+0x530`).",
    combat | CombatPart | optional | doc "The combat layer (types 50 and up but 90, `+0x7f8`..`+0x87f`): attack, armor, blast; None\nfor other masters.",
    capacity | CarryCapacity | doc "`+0x61c`, `attribute_max_amount`: how much an object of this master carries.",
    outline | Footprint | doc "`+0x688`, `+0x68c`: the `.dat`'s `outline_size` (x, y), an obstruction-type-11 object's\nshape radii (`FUN_141054fe0`).",
    outline_height | Distance | doc "`+0x690`: the `.dat`'s `outline_size` z, the height BUILD's scan takes for an object of\nobstruction types 11 to 13 (`FUN_14123aee0`).",
    clearance | Footprint | doc "`+0x5fc`, `clearance_size`: a completed building's foundation terrain covers its position\nplus and minus this.",
    building | BuildingMaster | optional | doc "What a building's completion reads (type 80), None for other masters.",
    storage | Array (Array Dyn) | doc "The resource storage (`attribute_type_held`, `attribute_amount_held`, `attribute_flag`:\n`+0x60a`, `+0x610`, `+0x628`): what an object of this master adds to its player's\nattributes, by its flag.",
    damage_sprites | Bool | doc "The master has damage sprites (`+0x638`..`+0x640`): a master change checks them\n(`FUN_1411859a0`).",
    fly_mode | FlyMode | doc "The `.dat`'s `fly_mode` (`+0x608`): 1 flies above the ground (a bird's Fly lifts it).",
    blast_defense | BlastDefense | doc "`area_effect_object_level` (`+0x62b`): the blasts that reach it.",
    garrison | GarrisonCapacity | doc "`+0x5d4`, `obj_max` (the `.dat`'s `garrison_capacity`): a building that garrisons takes a\ngather point (`FUN_140e7e9a0`).",
    recyclable | Bool | doc "`+0x680`, the `.dat`'s `recyclable`: its objects take ids from the negative range\n(`FUN_1415301b0`).",
    auto_gather | Bool | doc "`+0x681`, `enable_auto_gather`: an object of it blocking a spawn point stays\n(`FUN_141194170`).",
    gather_group | GatherGroup | doc "`+0x683`, `resource_gather_group`: the resource kind a gatherer's search\n(`ClosestResourceObject`) takes it for ([`GatherGroup`]).",
    hill_mode | HillMode | doc "`+0x604`, `hill_mode`: how a placement test checks the elevation.",
    fog_visibility | FogVisibility | doc "`+0x605`, `fog_visibility`: an object of it the player only explored stays a target\n(the Attack's update).",
    available | Bool | doc "`+0x5f0`, `available`: the player may make it (an effect's enable command, kind 2,\nchanges it).",
    disabled | Bool | doc "`+0x5f1`, `disabled`: an enable command leaves `available` as it is.",
    ghost_on_death | GhostMode | doc "`+0x682`, `create_doppelganger_on_death`: 2 leaves ghosts of an object of it for the\nplayers who explored its tile but do not see it, at its death and once they lose sight\nof it (`genie_core::vision::ghost`).",
    placement | PlacementTerrains | doc "The placement terrains (`+0x5f2`..`+0x5f8`).",
    death_sprite | SpriteId | optional | doc "The death sprite (`+0x480`, −1 for none) and the death spawns (`+0x5e4`, `+0x5e6`, −1 for\nnone), and what a dead object's steps read of the master\n([`crate::objects::lifecycle::MasterData`]), for a new object's `genie_core::objects::lifecycle::Lifecycle`.",
    death_spawns | Array (MasterId) | doc "The death spawns (`+0x5e4`, `+0x5e6`, −1 for none).",
    life | MasterData | optional | doc "What a dead object's steps read of the master.",
    standing_sprite | SpriteId | optional | doc "Its standing sprite (`+0x470`, −1 for none), which a combat master's attack shows too\n([`CombatPart`]).",
    standing_sprite_2 | SpriteId | optional | doc "Its second standing sprite (`+0x478`, the `.dat`'s `standing_graphic[1]`), whose idle\nanimation the object swaps in (`0x141071880`); None for none.",
    moving | MovingPart | optional | doc "The moving layer (types 30 and up but 90, `+0x748`..`+0x764`): sprites, turn speed, trail;\nNone for other masters.",
    missile | MissilePart | optional | doc "The missile layer (type 60, `+0x880`..`+0x888`): projectile type, modes and arc; None for\nother masters. Its flight reads [`Master::missile_stats`].",
    move_stats | MoveStats | optional | doc "What a unit of this master moves with, its speed with the master's walking sprite (the\nrun sprite `+0x750` if it has one, else the move sprite `+0x748`); None for a master that\ndoes not move.",
    animated | AnimatedPart | optional | doc "The animated layer (types 20 and up but 90, `+0x740`): the top speed; None for other\nmasters.",
    undead_sprite | SpriteId | optional | doc "`+0x488`, the undead sprite (`undeadSpriteId`, −1 for none).",
    occlusion | Occlusion | doc "`+0x650`, `occlusion_flag` (the `.dat`'s `occlusion_mode`).",
    selection_effect | SelectionEffect | doc "`+0x684`, the `.dat`'s `selection_effect`.",
    unit_level | InterfaceKind | doc "`+0x62f`, `unit_level` (the `.dat`'s `interface_kind`).",
    select_level | InteractionMode | doc "`+0x62d`, `select_level` (the `.dat`'s `interaction_mode`).",
    map_draw_level | MinimapMode | doc "`+0x62e`, `map_draw_level` (the `.dat`'s `minimap_mode`).",
    damage_graphics | Array (DamageGraphic) | doc "The damage sprites (`+0x638`, 16 bytes each; the save's `damage_sprite`), which\n[`Master::damage_sprites`] follows.",
    damage_graphic_entry | DamageGraphicEntry | doc "`+0x731`, `mDamageSpriteEntryMod`: the damage sprite the attributes 91, 156 and 157 change.",
  },
  MasterAttribute | doc "An attribute an effect changes on a master (an attribute command's third argument, its low\nbyte: `FUN_140ec2ac0` reads `c & 0xff`). The simulation names the ones it tells apart (below);\nany other is a number the data holds, which each master type's setter passes to its base's\nand the last one ignores." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  MasterData | doc "What the dead-object steps read from an object's master that the header save does not hold;\nthey come from the `.dat`." = {
    decay | AmountRate | doc "Master `+0x620`: how much of the held attribute a dead object loses per second.",
    undead | Bool | doc "Master `+0x490`: a dead object turns undead (state 6) instead of leaving.",
  },
  MasterField | doc "A master id as a master's data holds it (`missile_unit_id`, a trail's unit): a short the\neffects set, add to and scale (`PROJECTILE_UNIT`), so every value is kept, −1 and any other\nnegative one alike; it names a master when 0 or more ([`MasterField::master`])." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  MasterHitPoints | doc "A master's hit points (`+0x530`, the `.dat`'s `hit_points`): the whole points an object of it\nstarts with and heals up to (before powerups), a short the effects set, add to and scale\n(capped at 32767 where the game caps them). Every short is kept; [`HitPoints::of_master`] is\nthe game's conversion." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  MasterId | doc "A master's id: the `.dat`'s unit id, the place of the master in a player's masters\n([`crate::objects::masters::Master::id`]), so 0 or more. A field that holds −1 for none\nholds `Option<MasterId>` ([`MasterId::of_field`])." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  MasterKind | doc "A master's type (`+0x8`, the `.dat`'s `unit_type`): 10 to 80 in steps the game names (its\nconstants, the one definition of the type bytes: every routine that tests a type names it\nhere, and the attribute setters, slots 0x18, 0x20 and 0x28, differ by type). The routines that\ntest a type compare it with a threshold (`kind >= MasterKind::COMBAT`), so it is ordered. The\n`.dat` holds values the code does not name (0 for an empty slot, 90 and above for the data's\nown kinds), so the type is a newtype with named constants, not an enum: any byte the data holds\nis a type, and the named ones are values of the type (the reasoning of\n[`crate::objects::masters::ClassId`])." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  MasterRoles = [| 'ARMORED_ELEPHANT, 'BATTERING_RAM, 'BATTERING_RAM_1258, 'BOAT_CONVERTER, 'BOAT_HUNTER, 'BUILDER, 'BUILDINGS_ONLY_BLAST, 'BUILDING_BY_PRIORITY, 'CAPPED_RAM, 'CASTLE, 'CHU_KO_NU, 'CIRCLE_SIGHT, 'CLASS_LIST_ONLY, 'CLEARING_FLAG, 'COUNTED_PASTURE, 'DEAD_FARM, 'DEAD_FARM_SITE, 'DEAD_PASTURE, 'DEAD_PASTURE_MANGROVE, 'DEAD_RICE_FARM, 'DEATH_BLAST, 'DEFENDLESS, 'DEFENSIVE_SOLDIER, 'DEMOLITION_RAFT, 'DEMOLITION_SHIP, 'DOCK, 'DROP_SITE, 'ELITE_CHU_KO_NU, 'ELITE_SKIRMISHER, 'FARM, 'FARM_WAITER, 'FISH_TRAP, 'FLAMING_CAMEL, 'FLEMISH_MILITIA, 'FLEMISH_MILITIA_FEMALE, 'HEAVY_DEMOLITION_SHIP, 'HEAVY_INCENDIARY_SHIP, 'HORSE, 'HOUSE, 'IDLES_STILL, 'INCENDIARY_RAFT, 'INCENDIARY_SHIP, 'JADWIGA, 'KING, 'KING_UNLED, 'LIGHT_CAVALRY, 'LONG_PATH_MOVER, 'MARKET, 'MILITARY_235, 'MISSIONARY, 'MODE_TESTED, 'MONASTERY, 'MONUMENT, 'MOVING_RULE_EXEMPT, 'MULE_CART, 'NEVER_CONVERTED, 'PACKED_PEACEFUL, 'PASTURE, 'PASTURE_1889, 'PASTURE_MANGROVE, 'PEACEFUL_SOLDIER, 'PETARD, 'PORT, 'QUIET_SWING, 'RAM_TARGETS_ONLY, 'REFILL_LISTED, 'REGATHERED, 'RELIC, 'RICE_FARM, 'SCOUT_CAVALRY, 'SEARCH_FROM_FOOTPRINT, 'SIEGE_ELEPHANT, 'SIEGE_RAM, 'SIEGE_TOWER, 'SKIRMISHER, 'STOP_FARM, 'STRAYING_MISS, 'TAMAR, 'TERRAIN_ORIGINAL, 'TORCH_CONVERTING, 'TOWER_SPARED, 'TOWN_CENTRE, 'TOWN_CENTRE_621, 'TRADE_TARGET, 'TRANSFORMED_TROPHY, 'TRAPPER, 'TRAP_WAITER, 'TREBUCHET, 'TREBUCHET_PACKED, 'UNEXHAUSTED, 'UNSTOPPED, 'UNTURNED_ATTACKER, 'VILLAGER_ANY, 'VILLAGER_FEMALE, 'VILLAGER_MALE, 'WARRIOR_PRIEST, 'WONDER |],
  MasterSlots | doc "The master ids the engine names, one field each." = {
    farm | MasterId | doc "The farm (`0x32`): a mill's queue buys it, and BUILD places it as the rice farm on mangrove or rice farm terrain.",
    mill | MasterId | doc "The mill (`0x44`), whose livestock makes food (the tracker's list `FUN_14104f960`).",
    castle | MasterId | doc "The castle (`0x52`), whose death lowers its owner's attribute 134 (`FUN_1411dbb70`).",
    villager_male | MasterId | doc "The male villager (`0x53`): the master QUEUE draws a sex for, and the one the generic villager (`0x712`) becomes first (`FUN_1411cbc40`).",
    market | MasterId | doc "The market (raw `0x60f0`), whose own trade units the work command never retakes and whose sight the AI players' market lists follow.",
    town_centre | MasterId | doc "The town centre (raw `0x6109`).",
    flare | MasterId | doc "Master 112, the `.dat`'s `FLARE`.",
    builder | MasterId | doc "The builder (`0x76`) the train locations name for every villager.",
    villager_repairer_male | MasterId | doc "Master 156, the `.dat`'s `VMREP`.",
    fish_trap | MasterId | doc "The fish trap (raw `0x6163`), which only the fishing ships gather from.",
    castle_mode_1 | MasterId | doc "The building of the content mode 1 (`0xd1`) that stands for the castle (`FUN_140fe0ec0`).",
    villager_repairer_female | MasterId | doc "Master 222, the `.dat`'s `VFREP`.",
    doppelganger | MasterId | doc "Master 243, the `.dat`'s `DOPL`.",
    flare_2 | MasterId | doc "Master 274, the `.dat`'s `FLARE2`.",
    villager_female | MasterId | doc "The female villager (`0x125`).",
    king | MasterId | doc "The king (`0x1b2`).",
    town_centre_444 | MasterId | doc "A town centre (`0x1bc`), whose tracker list the town centre counts read after 109's.",
    boarding_galley | MasterId | doc "Master 535, the `.dat`'s `BDGAL`.",
    town_centre_621 | MasterId | doc "A town centre (`0x26d`): a delete also tells the world's `+0x820`, a builder may place it and its availability counts the town centres standing.",
    flare_4 | MasterId | doc "Master 697, the `.dat`'s `FLARE4`.",
    rice_farm | MasterId | doc "Master 1187, the `.dat`'s `RFARM`.",
    market_1647 | MasterId | doc "Master 1647, the `.dat`'s `TDWS4`.",
    mule_cart | MasterId | doc "The mule cart (`.dat` MULECART, class 3, `0x710`, raw `0x67ac`), which answers the town bell besides the villagers and which a building's watch leaves out.",
    pasture_1889 | MasterId | doc "The pasture master (`0x761`) whose foundation keeps its snow and whose stack unit depends on the rice terrain under it.",
    pasture_mangrove | MasterId | doc "The mangrove pasture (`.dat` `PASTURE_MANGROVE`, `0x765`): a completed building's stack unit on mangrove or rice terrain, and a pasture a gather and a hunt treat apart.",
    pasture | MasterId | doc "The pasture (`.dat` `PASTURE`, 1897), which a gather and a hunt treat apart with `PASTURE_MANGROVE`.",
    pasture_argali | MasterId | doc "Master 1899, the `.dat`'s `Argali (Pasture)`.",
    pasture_ibex | MasterId | doc "Master 1900, the `.dat`'s `Ibex (Pasture)`.",
  },
  Masters | doc "A player's masters by id." = {
    by_id | Array (Master),
  },
  MastersTuning | doc "The `masters` port's tuning values." = {
    handicap_floor | Number | doc "A handicap's attack factor above this raises an attack class at 0 (`FUN_1410c12b0`, `DAT_14330eb8c`).\n\n`masters::HANDICAP_FLOOR`: 1 in build 158041.",
    missile_speed_cap | Number | doc "The most speed a capped add or multiply leaves a missile master (`FUN_1410a8b60`, `FUN_1410a8c00`, `DAT_142e7f38c`).\n\n`masters::MISSILE_SPEED_CAP`: 20 in build 158041.",
    speed_cap | Number | doc "The most speed a capped add or multiply leaves a master (`FUN_1410a8b60`, `FUN_1410a8c00`, `DAT_142f52490`).\n\n`masters::SPEED_CAP`: 4.5 in build 158041.",
  },
  MinimapMode | doc "A master's minimap mode (`map_draw_level`, `+0x62e`; the `.dat`'s `minimap_mode`, openage's\nnames): the dot its objects draw on the minimap. The simulation only keeps it; every byte is\nkept." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  MissSpread | doc "How far a missed missile strays per tile of the way (a master's `missed_missile_spread`,\n`+0x860`, the attribute \"Attack Dispersion\"), which a miss multiplies its gap by." = Number,
  MissileCount | doc "A count of missiles (a byte): a master's most in a volley (`max_attacks_in_volley`,\n`+0x8c4`, which the effects set, add to and scale) and those of the volley under way an\nobject fired already (`next_volley`, `+0xa04`). Every byte is kept." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  MissilePart | doc "The missile layer of a master of type 60 (`RGE_Master_Missile_Object`, `+0x880`..`+0x888`;\nthe `.dat`'s projectile section, genieutils' `Projectile`): its projectile type, smart, hit\nand vanish modes and its arc. Only a missile holds it." = {
    projectile_kind | ProjectileKind | doc "`projectile_type` (`+0x880`, the `.dat`'s; the save does not hold it).",
    smart_mode | SmartMode | doc "`smart_mode` (`+0x881`, the save's `targetting_type`).",
    hit_mode | HitMode | doc "`hit_mode` (`+0x882`, the save's `missile_hit_info`).",
    vanish_mode | VanishMode | doc "`vanish_mode` (`+0x883`, the save's `missile_die_info`).",
    arc | ArcRatio | doc "`projectile_arc` (`+0x888`, the save's `ballistics_ratio`).",
  },
  MissileTuning | doc "The `missile` port's tuning values." = {
    beyond | Number | doc "A missile past its reach ends this far beyond its point (`DAT_142eb5be8`).\n\n`missile::BEYOND`: -2 in build 158041.",
    height_share | Number | doc "A target's height counts a third of its master's height radius (`FUN_140a9c600`, `DAT_142eb1c98`).\n\n`missile::HEIGHT_SHARE`: 3 in build 158041.",
    landing | Number | doc "A missile within this of its point may touch the ground (`DAT_142eb5690`, `+0x994`).\n\n`missile::LANDING`: 0.1 in build 158041.",
    query_edge | Number | doc "The hit query holds its ends this far inside the map's far edges (`FUN_1411570c0`, `DAT_142eb5690`).\n\n`missile::QUERY_EDGE`: 0.1 in build 158041.",
    reach_margin | Number | doc "The reach adds this to the shooter's radius and range (`FUN_141081020`, `DAT_142e8c150`).\n\n`missile::REACH_MARGIN`: 2 in build 158041.",
    volley_reach_margin | Number | doc "What a volley's extra missile's reach adds to the range (`FUN_141226690`).\n\n`missile::VOLLEY_REACH_MARGIN`: 6 in build 158041.",
  },
  Model | doc "The game's data a world plays on (FD-046-D02, D04): each table shared between worlds until\nits first write (`Arc::make_mut`), so forks and parallel instances hold one stock model." = {
    masters | Array (Masters) | doc "Per player, the masters (the game's per-player copies), which BUILD reads; a player\nwithout them stops at its own BUILD.",
    graphics | Graphics | doc "What the sprite clock reads of each graphic (the `.dat`'s).",
    drop_sites | Array (DropSite) | doc "The game's drop-site table (`dropsites.json`).",
    lines | UnitLines | doc "The game's unit lines (`unitlines.json`); empty when not loaded.",
    linked_techs | {} | doc "The game's linked technologies (`linkedTechs.json`, the table at the game settings'\n`+0x18` that `FUN_140f39f40` looks up), by technology; empty when not loaded.",
    techs | Array (TechDef) | doc "The `.dat`'s technologies, by id.",
    effects | Array (Array (EffectCommand)) | doc "The world's effect table (`+0x128`, `TRIBE_Effects`): every effect's commands by id, the\n`.dat`'s (the patch table, D11).",
    tech_tree | TechTree | doc "The game's tech tree table and its civilisations' unique units, which the defeat check's\ncount of the units a building will train reads.",
    roles | Roles | doc "The roles of the ids, the build layer's (FD-046-D04, D08).",
    slots | Slots | doc "The ids the engine names by role, the build layer's.",
    tuning | Tuning | doc "The tuning values, the build layer's (D32).",
  },
  ModifyLocation | doc "The location a technology change (kind 8) changes: its third argument, below 1 every\nlocation, else the entry at that index (past the technology's locations a new one, a copy of\nthe last with no building). Every short is kept." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  ModifyMode | doc "What a technology change (kind 8, `FUN_1415c3f20`'s `0x6f` case) changes: its second\nargument. The cost modes (0 to 3, `0x4000` to `0x4003`, `0xd` to `0x11`) and the research\ntime modes (−1 to −3) map to a [`ChangeMode`]; the others name a field. Every short is kept." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  MoveAlgorithm | doc "The set's flag names joined by ` | `, unnamed bits as one hexadecimal number (`0x10`)." = String,
  MoveStats | doc "What movement reads of the unit's master." = {
    fly_mode | FlyMode | doc "The master's `fly_mode` (`+0x608`): how its place takes the ground's height\n(`Mover::grounded`).",
    speed | Speed | doc "The top speed (object slot 65, `maximumSpeed`, `0x141202c70` -> `FUN_14114d1d0`): the\nmaster's speed ([`MoveStats::base`]), times the current sprite's speed factor when that is\nabove 0. A column derived from the two: the sprite's one transform writes it\n(`genie_core::objects::sprite::new_sprite`), and so does a change of the base.",
    base | Speed | doc "The master's speed (`+0x740`, the master's slot 0xe8): the top speed's base.",
    turn_rate | TurnRate | doc "Master `+0x774`: the most the unit turns per second (`turn_rate`).",
    turn_radius | Distance | doc "Master `+0x76c` and `+0x770`: the turn radius is `turn_radius × speed / turn_radius_speed`\n(0 and the largest float for every master the game copies, `turn_rate`).",
    turn_radius_speed | Speed | doc "`+0x770`: the speed at which the turn radius is its value.",
    radius | Radii | doc "Master `+0x5d8`, `+0x5dc`, `+0x5e0`.",
    restriction | RestrictionId | doc "The master's terrain restriction (`+0x606`) and the terrain classes it lets the unit stand\non (its mask).",
    restriction_mask | TerrainMask | doc "The terrain classes the restriction lets it stand on (its mask).",
    turn_time | Seconds | doc "The master's turn time (`+0x758`, the `.dat`'s `rotation_speed`): the seconds between the\nfacet steps of a unit facing a target; 0 faces at once (`FUN_141162db0`).",
    move_algorithm | MoveAlgorithm | doc "The master's move algorithm (`+0x768`, the `.dat`'s `move_algorithm`).",
    min_collision | Number | doc "Master `+0x780`, `min_collision_size_multiplier`: the walk's query grows moving allies by\nthe unit's radius times this.",
    fast_turn | Bool | doc "The master's object flags (`+0x654`) have bit 1: the unit turns a hundred times faster.",
    facets | SpriteFacets | optional | doc "The facets the facing routines read of the unit's current sprite: the master's, when\nevery sprite it shows has the same count and bit 1 (None otherwise, or without sprites).",
    weapon_range | Distance | doc "The master's weapon range (slot 0x230, `+0x828`; 0 for an object without combat values),\nwhich the drop-off walker's start test reads (`FUN_140fa0110`).",
  },
  MoveToTuning | doc "The `move_to` port's tuning values." = {
    arrived | Number | doc "A `MoveTo`'s start counts the unit at its target within this gap (`0x140aa2100`, `DAT_142eb99cc`).\n\n`move_to::ARRIVED`: 0.01 in build 158041.",
    off_high | Number | doc "A target leaves the `MoveTo`'s point when its offset from it on either axis is above this (`DAT_142e7f384`).\n\n`move_to::OFF_HIGH`: 0.5 in build 158041.",
    off_low | Number | doc "A target leaves the `MoveTo`'s point when its offset from it on either axis is below this (`DAT_142eb6e58`).\n\n`move_to::OFF_LOW`: -0.5 in build 158041.",
  },
  MovementTuning | doc "The `movement` port's tuning values." = {
    ally_pause | Number | doc "The pause a kept hit's ranking gives a unit the walker outranks: 0.1 for an ally (`DAT_142eb5690`), 0.5 for another (`DAT_142e7f384`).\n\n`movement::ALLY_PAUSE`: 0.1 in build 158041.",
    close | Number | doc "A waypoint or target nearer than this takes the close-in path (`DAT_14330eb8c`).\n\n`movement::CLOSE`: 1 in build 158041.",
    edge_gap | Number | doc "How far inside the map's edge a moving unit's footprint stays (`DAT_142eb99cc`), and how far below the edge a position stays (`DAT_142eb1e9c`).\n\n`movement::EDGE_GAP`: 0.01 in build 158041.",
    edge_position_gap | Number | doc "How far inside the map's edge a moving unit's footprint stays (`DAT_142eb99cc`), and how far below the edge a position stays (`DAT_142eb1e9c`).\n\n`movement::EDGE_POSITION_GAP`: 0.001 in build 158041.",
    fast_turn | Number | doc "A master whose object flags have bit 1 turns as if dt were this many times longer (`DAT_14330ebcc`).\n\n`movement::FAST_TURN`: 100 in build 158041.",
    long_path_grow | Number | doc "A long path's stretch is checked for walls with the unit's radius times this (`DAT_142e85190`).\n\n`movement::LONG_PATH_GROW`: 0.6 in build 158041.",
    look_ahead | Number | doc "How far ahead of the group its front is looked for (`DAT_14330ebcc`).\n\n`movement::LOOK_AHEAD`: 100 in build 158041.",
    new_pather_radius | Number | doc "The widest unit the new short pather takes (`DAT_142e7f384`, `FUN_140f9e540`'s load at 0x140f9e713).\n\n`movement::NEW_PATHER_RADIUS`: 0.5 in build 158041.",
    other_pause | Number | doc "The pause a kept hit's ranking gives a unit the walker outranks: 0.1 for an ally (`DAT_142eb5690`), 0.5 for another (`DAT_142e7f384`).\n\n`movement::OTHER_PAUSE`: 0.5 in build 158041.",
    pushed | Number | doc "A unit pushed into a met object counts beyond its radius times this (`DAT_142eb880c`).\n\n`movement::PUSHED`: 0.25 in build 158041.",
    range_floor | Number | doc "What a gate's annex's gap loses against the gate's own (`XMM14`, the motion step's load at 0x1411510e7, the same as `RANGE_FLOOR`'s).\n\n`movement::RANGE_FLOOR`: 0.1 in build 158041.",
    reach_near | Number | doc "A point whose squared gap to the unit's footprint is below this is not reached when the short pather did not reach it (`FUN_140fa0370`, `DAT_14330eb8c`).\n\n`movement::REACH_NEAR`: 1 in build 158041.",
    reach_short | Number | doc "A point within this many tiles is the short pather's to reach (`FUN_140fa0370`, `DAT_142eb0f4c`).\n\n`movement::REACH_SHORT`: 10 in build 158041.",
    shortest | Number | doc "A path shorter than this is too short (`DAT_142eb99cc`).\n\n`movement::SHORTEST`: 0.01 in build 158041.",
    short_reach | Number | doc "The short pather serves a waypoint this near (`DAT_142ec9ec0`), and one this near a target before the tile pathfinder (`DAT_142eb0f4c`).\n\n`movement::SHORT_REACH`: 16 in build 158041.",
    split | Number | doc "A new level's stretches longer than this squared get a midpoint (`DAT_142ed6f20`).\n\n`movement::SPLIT`: 25 in build 158041.",
    straight_grow | Number | doc "`FUN_141142750` grows the walk's query by the unit's radius times `DAT_142e7f384`.\n\n`movement::STRAIGHT_GROW`: 0.5 in build 158041.",
    stuck_pause | Number | doc "The pause a level at its last waypoint without a path gives its own unit while it may still try (`DAT_142eb5690`).\n\n`movement::STUCK_PAUSE`: 0.1 in build 158041.",
    target_short_reach | Number | doc "The short pather serves a waypoint this near (`DAT_142ec9ec0`), and one this near a target before the tile pathfinder (`DAT_142eb0f4c`).\n\n`movement::TARGET_SHORT_REACH`: 10 in build 158041.",
    uncapped_speed | Number | doc "The speed below which a free group member's speed is not capped by its top speed (slot 0x5e0).\n\n`movement::UNCAPPED_SPEED`: 10 in build 158041.",
    user_waypoint_middle | Number | doc "A unit's own waypoint on a tile's edge moves this far into the tile (`FUN_14114e920`, `DAT_142e7f384`).\n\n`movement::USER_WAYPOINT_MIDDLE`: 0.5 in build 158041.",
    wide_range | Number | doc "What a path end's bonus adds to the walk's range (`DAT_142eb1c98`).\n\n`movement::WIDE_RANGE`: 3 in build 158041.",
  },
  MovingPart | doc "The moving layer of a master of type 30 and up but 90 (`RGE_Master_Moving_Object`,\n`+0x748`..`+0x764`; the `.dat`'s type-30 section, genieutils' `DeadFish`): its walking and\nrunning sprites, its turn speed and its trail. A moving object (30) and every type above hold\nit; what its objects move with is [`Master::move_stats`], which these values and the base's\nfollow." = {
    move_sprite | SpriteId | optional | doc "Its walking sprite (`+0x748`, `move_sprite_id`; the unit's slot 0x7c8) and its running\none (`+0x750`, `run_sprite_id`; slot 0x7d0), −1 for none.",
    run_sprite | SpriteId | optional | doc "Its running sprite (`+0x750`), −1 for none.",
    turn_speed | Seconds | doc "`+0x758`, `turn_speed` (the `.dat`'s `rotation_speed`), which\n[`crate::movement::MoveStats::turn_time`] follows.",
    trail | Trail | doc "A moving master's trail (`+0x75e`..`+0x764`).",
  },
  ObjectFlags | doc "The set's flag names joined by ` | `, unnamed bits as one hexadecimal number (`0x10`)." = String,
  ObjectState | doc "An object's state (`+0x640`, the save's `object_state`, `RGE_Static_Object::set_object_state`):\nthe steps of its update (`genie_core::objects::lifecycle::Lifecycle::update`). The game compares\nthe numbers (`state < 3` alive or not yet built, `7 <= state` on its way out), so the states\nkeep their order." = [| 'Foundation, 'Unfinished, 'Alive, 'Dying, 'DyingSprite, 'Dead, 'Undead, 'Removed, 'Gone |],
  ObjectsKind | doc "The objects' kinds (200 to 206), which the slice does not run but for the masters of their\nown it holds none of." = [| 'OwnMasters (Change), 'Object (Change), 'ObjectMaster |],
  ObstructionClass | doc "A master's obstruction class (`+0x652`, the `.dat`'s `obstruction_class`, the blockage\nclass; an obstruction record's class): the kind of thing its record blocks as. The game's\ntests name 0 (no record) and 5 (a gate, whose tile marks carry bit `0x8000`); the `.dat`'s\nother classes are named by the masters that hold them." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  ObstructionKind | doc "A master's obstruction type (`+0x651`, the `.dat`'s `obstruction_type`; an obstruction\nrecord's byte `+1`): whether its objects get a record and a mesh shape, the shape the walk\ntests (a box or a circle) and whether the record marks its tiles. The `.dat` holds types the\nsimulation does not tell apart, so the type is a newtype: the named ones are those its tests\nname." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  Occlusion | doc "A master's occlusion mode (`occlusion_flag`, `+0x650`; the `.dat`'s `occlusion_mode`): how the\nrenderer shows its objects behind others. The simulation only keeps it; every byte is kept." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  Offset | doc "A displacement on the map in the map's order: x and y in tiles, z the height. A missile's\ndirection (`+0x68`..`+0x70`) and its step of an update (`+0x7dc`..`+0x7e4`), a master's\nweapon offset from its object's place (`+0x844`..`+0x84c`)." = Array (Number),
  OrderTuning | doc "The `order` port's tuning values." = {
    box_start | Number | doc "`DAT_142eea788`.\n\n`order::BOX_START`: 10000 in build 158041.",
    cart_move_range | Number | doc "A mule cart's move range to a building (`FUN_1411c5d80`, master type 80; `DAT_142e7f388`).\n\n`order::CART_MOVE_RANGE`: 0.75 in build 158041.",
    edge | Number | doc "`DAT_14330eb8c`.\n\n`order::EDGE`: 1 in build 158041.",
    grid_area | Number | doc "`DAT_142eb4838`.\n\n`order::GRID_AREA`: 1.5 in build 158041.",
    grid_step | Number | doc "`DAT_142e7f384`.\n\n`order::GRID_STEP`: 0.5 in build 158041.",
    guard_range | Number | doc "The range of GUARD's defend order (`DAT_142eb3634`, `World::guard`).\n\n`order::GUARD_RANGE`: 2.5 in build 158041.",
    split_path_reach | Number | doc "Units nearer than this are measured by a path (`FUN_140fd76d0`, `DAT_142e7f38c`) while `DAT_1439e60e3` (1 at run time) holds.\n\n`order::SPLIT_PATH_REACH`: 20 in build 158041.",
    split_speed_gap | Number | doc "Units whose speeds differ by more than this do not join where the player breaks formations by speed (`FUN_140fd76d0`, `DAT_143cc2918`).\n\n`order::SPLIT_SPEED_GAP`: 0.2 in build 158041.",
    spread | Number | doc "`DAT_142eb9430`.\n\n`order::SPREAD`: 8 in build 158041.",
    table_drop_far | Number | doc "The drop-site table's search starts beyond this squared distance (`FUN_141658e20`, `DAT_142f89ac4`).\n\n`order::TABLE_DROP_FAR`: 1000000 in build 158041.",
    waypoint_apart | Number | doc "A patrol's waypoint counts when it is at least this far from the last one kept on x or on y (`FUN_14161b970`, `DAT_14330eb8c`).\n\n`order::WAYPOINT_APART`: 1 in build 158041.",
    waypoint_apart_low | Number | doc "A patrol's waypoint counts when its offset from the last one kept on x or on y is at most this (`FUN_14161b970`, `DAT_14330ec20`).\n\n`order::WAYPOINT_APART_LOW`: -1 in build 158041.",
  },
  Party | doc "Which players a block of the base's kinds reaches." = [| 'Own, 'Allies, 'Enemies, 'Neutrals, 'Gaia |],
  PastureTuning | doc "The `pasture` port's tuning values." = {
    end | Number | doc "An edge's end (`DAT_14330eb8c`).\n\n`pasture::END`: 1 in build 158041.",
    inset | Number | doc "The edges lie this far inside the pasture's ground radius (`DAT_142e7f384`).\n\n`pasture::INSET`: 0.5 in build 158041.",
    step | Number | doc "The step along an edge (`DAT_142e8c148`).\n\n`pasture::STEP`: 0.3 in build 158041.",
  },
  PlacementTerrains | doc "A master's placement terrains (`+0x5f2`..`+0x5f8`, the `.dat`'s `placement_side_terrain` and\n`placement_terrain`, each none for −1): the terrains it must stand beside and the terrains it\nmust stand on (`genie_core::production::spawn::placement_terrains`)." = {
    beside | Array (TerrainId) | doc "The side terrains (`+0x5f2`, `+0x5f4`).",
    on | Array (TerrainId) | doc "The terrains (`+0x5f6`, `+0x5f8`).",
  },
  ProjectileKind | doc "A missile master's projectile type (the `.dat`'s `projectile_type`, `+0x880`, not saved): how\nits missile flies. Type 0 flies straight along its unit direction, type 3 takes its whole way\nin one step; types 1 and 2 are not modelled." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  Radii | doc "An object's three radii in the map's order: x and y in tiles, z the height (a master's\n`radius_x`, `radius_y`, `radius_z`, `+0x5d8`..`+0x5e0`). Each is half the object's size along\nits axis." = Array (Number),
  Regeneration | doc "A regeneration rate in hit points a minute (a float): a master's (`regeneration_rate`,\n`+0x8b4`, which the effects set, add to and scale), an object's powerup (`+0xa0c`) and\nstinger, and a hero's bonus. A negative rate takes hit points. Each operator is the one\n`f32` operation the game does; every value is kept." = Number,
  RegistryTuning | doc "The `registry` port's tuning values." = {
    margin | Number | doc "The query box's margin (`DAT_142ec9eb8`).\n\n`registry::MARGIN`: 7 in build 158041.",
    most_radius | Number | doc "The query's cap on the radius (`DAT_142f64e88`).\n\n`registry::MOST_RADIUS`: 44 in build 158041.",
  },
  RepairTuning | doc "The `repair` port's tuning values." = {
    extra_repairer | Number | doc "The hit points below which a target in state 2 is not repaired (`DAT_142e7f384`), and the share each repairer past the first adds to the work (the same constant).\n\n`repair::EXTRA_REPAIRER`: 0.5 in build 158041.",
    least_hp | Number | doc "The hit points below which a target in state 2 is not repaired (`DAT_142e7f384`), and the share each repairer past the first adds to the work (the same constant).\n\n`repair::LEAST_HP`: 0.5 in build 158041.",
    moving_reach | Number | doc "What a moving target (`FUN_140fdd080`) or a scenario's game mode adds to the reach (`DAT_142e8c150`).\n\n`repair::MOVING_REACH`: 2 in build 158041.",
    reach | Number | doc "The gap within which a repairer reaches its target (`DAT_142eb5690`).\n\n`repair::REACH`: 0.1 in build 158041.",
  },
  ResourceChange | doc "How a resource command changes the resource (its second argument's low byte: 0 sets, any\nother adds)." = [| 'Set, 'Add |],
  RestrictionField | doc "A terrain restriction as a master's data holds it (`defense_terrain_bonus`, `+0x820`): a\nshort the effects set, add to and scale (`TERRAIN_DEFENSE_BONUS`), every value kept; it names\na restriction when 0 or more ([`RestrictionField::restriction`])." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  RestrictionId | doc "A terrain restriction (the `.dat`'s table; a master's `+0x606`, the save's\n`terrain_restriction_mask_id`): its place in the restrictions' tables, each the terrains'\nvalues an object of it reads (`genie_core::map::terrain::Terrain::restriction_mask`, the\npathing's planners). A field holds −1 for none." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 65535),
  Roles | doc "Each id space's roles by id (FD-046-D04): a test is one load and one AND. An id beyond a\ntable holds no role." = {
    classes | { _ | Array (ClassRoles) } | doc "By class.",
    masters | { _ | Array (MasterRoles) } | doc "By master.",
    techs | { _ | Array (TechRoles) } | doc "By technology.",
    attributes | { _ | Array (AttributeRoles) } | doc "By player attribute.",
  },
  RunPattern | doc "A master's run pattern (`run_pattern`, `+0x7b9`): the effects set and add to it, and the\nsimulation only keeps it; every byte is kept." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  Seconds | doc "A span in seconds as the game's `f32` holds it: an update's (`world+0x164`, the dt over\n1000), the timers that count it down or up, the masters' times. Each operator is the one\n`f32` operation the game does; a comparison is `f32`'s (a NaN compares false)." = Number,
  SelectionEffect | doc "A master's selection effect (`+0x684`, the `.dat`'s `selection_effect`; openage's names): its\nhit point bar and outline when selected. The simulation only keeps it; every byte is kept." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  Shown | doc "What a combat master shows of its values (`+0x856`, `+0x858`, `+0x854`; the pierce armor it\nshows is the creatable layer's, [`CreatablePart::pierce_armor_shown`])." = {
    attack | DamageAmount | doc "`+0x856`, `orig_weapon`.",
    range | Distance | doc "`+0x858`, `orig_weapon_range`.",
    melee_armor | DamageAmount | doc "`+0x854`, `orig_armor`.",
  },
  Slots | doc "The ids the engine names by role, one id each, by id space (FD-046-D04)." = {
    class | ClassSlots | doc "The class slots.",
    master | MasterSlots | doc "The master slots.",
    tech | TechSlots | doc "The tech slots.",
    attribute | AttributeSlots | doc "The attribute slots.",
  },
  SmartMode | doc "The set's flag names joined by ` | `, unnamed bits as one hexadecimal number (`0x10`)." = String,
  SoundEventId | doc "A sound event by its id (`mEventId`, the audio engine's event): what a task's sounds name\n(`+0x60`, `+0x78`). The `.dat`'s event 0 with sound files is the default event." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0),
  SoundEvents | doc "`+0x60` and `+0x78` of a task: the event ids of its gathering and its deposit sound, as the\ntask's load (`FUN_141062470`) leaves them. A terrain look task (159) names its dying and its\nundead sprite with their ids (`genie_core::combat::abilities`)." = {
    gathering | SoundEventId | doc "The gathering sound's event (`+0x60`).",
    deposit | SoundEventId | doc "The deposit sound's event (`+0x78`).",
  },
  SpacingModifier | doc "A master's spacing modifier (`+0x8b8`, `mSpacingModifier`; the `.dat`'s \"flank attack\nmodifier\"): with its radius on x the unit's radius in a group's formation (`FUN_141025920`)." = Number,
  SpatialTuning | doc "The `spatial` port's tuning values." = {
    closest_range | Number | doc "The range of `ClosestObject`'s reachability check (`FUN_140c488b0`, `DAT_142eb5690`).\n\n`spatial::CLOSEST_RANGE`: 0.1 in build 158041.",
    footprint_edge | Number | doc "The footprint's last tile stops short of its edge by this (`DAT_142eb1e9c`).\n\n`spatial::FOOTPRINT_EDGE`: 0.001 in build 158041.",
    search_reuse_squared | Number | doc "How near (squared) a unit AI's search comes to the last one's place to skip its query (`FUN_140c63e20`).\n\n`spatial::SEARCH_REUSE_SQUARED`: 25 in build 158041.",
  },
  SpawnTuning | doc "The `spawn` port's tuning values." = {
    build_scan | Number | doc "How far BUILD's placement scan looks around the point (`FUN_14123aee0`, `DAT_142eb9430`).\n\n`spawn::BUILD_SCAN`: 8 in build 158041.",
    gap | Number | doc "What a small unit's step adds to twice its radius (`DAT_142eb5690`).\n\n`spawn::GAP`: 0.1 in build 158041.",
    inside | Number | doc "How far inside its far edges a box's last tile lies (`DAT_142eb1e9c`).\n\n`spawn::INSIDE`: 0.001 in build 158041.",
    passable | Number | doc "A tile whose terrain's restriction value is this or less is not passable (`DAT_14330eb78`).\n\n`spawn::PASSABLE`: 0.05 in build 158041.",
    reach | Number | doc "The placement test's objects lie within this many tiles of the point (`DAT_142eb9430`).\n\n`spawn::REACH`: 8 in build 158041.",
    side_share | Number | doc "The share of a side the first segments cover (`DAT_142eb880c`).\n\n`spawn::SIDE_SHARE`: 0.25 in build 158041.",
    small | Number | doc "A unit smaller than this on both axes (`DAT_142f5d120`) steps by twice its radius plus `SpawnTuning::gap`.\n\n`spawn::SMALL`: 0.45 in build 158041.",
    start_right_z | Number | doc "A new moving object's right vector's z (`FUN_1411580a0` reads `DAT_14330ec20`).\n\n`spawn::START_RIGHT_Z`: -1 in build 158041.",
  },
  SpecialAttack | doc "A master's special attack (`special_attack_flag`, `+0x8d8`), as a hit on its object reads it\n(`FUN_1412108e0`). Every byte is kept." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  Speed | doc "A speed in tiles per second as the game's `f32` holds it: a master's speed, a unit's top\nspeed and forward speed, a group's most forward speed, a missile's speed, the speed at which a\nturn radius holds. Each operator is the one `f32` operation the game does, in its order; a\nspeed over a span of seconds is a [`Distance`]. A comparison is `f32`'s (a NaN compares\nfalse)." = Number,
  SpeedMultiplier | doc "A `.dat` graphic's `speed_multiplier` (`+0xc`): it scales the sprite's frame duration and,\nabove 0, a moving object's top speed." = Number,
  SpriteFacets | doc "What the facing routines read of the current sprite: its facets and whether its sequence\nflags have bit 1 (`+0x1a`)." = {
    count | FacetCount | doc "How many facets.",
    turns | Bool | doc "Its sequence flags hold [`crate::objects::SpriteFlags::TURNS`] (`+0x1a`): the sprite\nturns.",
  },
  SpriteFlags | doc "The set's flag names joined by ` | `, unnamed bits as one hexadecimal number (`0x10`)." = String,
  SpriteId | doc "A sprite (a `.dat` graphic) by its id, 0 and up: what a master's and a task's sprite\nfields name and the world's sprite table holds ([`Model::graphics`](crate::model::Model::graphics)). The\ngame's −1 (or any id below 0) is none, which an `Option` holds ([`SpriteId::of_data`])." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  SpriteTuning | doc "The `sprite` port's tuning values." = {
    shortest | Number | doc "The shortest frame interval (`0x3a83126f`, also `DAT_142eb1e9c`).\n\n`sprite::SHORTEST`: 0.001 in build 158041.",
  },
  TargetOwner | doc "A task's owner type (`+0x18`, `owner_type`; the `.dat`'s `target_diplomacy`): whose targets\nit is for, as the task's test on a target reads it (`FUN_1411a8620`). Every byte is kept;\none not named here is for anyone's." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  Task | doc "One task of a master's task list (`RGE_Task`), with the memory offsets the task finder reads\n(the save's names; the `.dat`'s in brackets where they differ)." = {
    id | TaskId | doc "`+0xa`.",
    action_kind | ActionKind | doc "`+0xe`: the action the task makes the unit do.",
    object_group | ClassId | optional | doc "`+0x10`: the target class the task is for, none (−1) for any.",
    object_id | MasterId | optional | doc "`+0x12`: the target master, -1 for any.",
    combat_level | std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255) | doc "`+0x14`, `combat_level` (`enable_targeting`): the task is for a target's combat level.",
    combat_level_flag | TaskFlags | doc "`+0x15`, `combat_level_flag`: a generation task (151, `genie_core::combat::abilities`) of a\ncombat unit with [`TaskFlags::UNITS_ALWAYS`] or of a building with\n[`TaskFlags::BUILDINGS_ALWAYS`] works on its own; a removal reward task (161) with any\nflag pays the master's cost of its resource times the rate.",
    terrain | TaskTerrain | doc "`+0x16`: the terrain the task is for, -1 for none.",
    owner_type | TargetOwner | doc "`+0x18`, `owner_type` (`target_diplomacy`): whose targets.",
    holding_attr | std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255) | doc "`+0x19`, `holding_attr` (`carry_check`): 1 wants a target holding the task's resource.",
    attribute_type | AttributeId | optional | doc "`+0x20` to `+0x26`, `attribute_type` to `attribute_type4` (`resource_in`,\n`resource_multiplier`: the attribute that scales the gathering, `resource_out`,\n`unused_resource`).",
    attribute_type2 | AttributeId | optional | doc "`+0x22`, `attribute_type2` (`resource_multiplier`): the attribute that scales the gathering.",
    attribute_type3 | AttributeId | optional | doc "`+0x24`, `attribute_type3` (`resource_out`).",
    attribute_type4 | AttributeId | optional | doc "`+0x26`, `attribute_type4` (`unused_resource`).",
    wait_time | Seconds | doc "`+0x1c`, `search_wait_time`: a Fly task's rest between flights.",
    work_val1 | WorkValue | doc "`+0x28`, the save's `work_val1`; `+0x2c`, `work_val2`.",
    work_val2 | WorkValue | doc "`+0x2c`, the save's `work_val2`.",
    work_range | Distance | doc "`+0x30`: how near the target the work is done.",
    work_flag | std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767) | doc "`+0x34`, `work_flag` (the `.dat`'s `gather_type`): a Make adds to its player's attribute,\nnot to its object's holding (`genie_core::gathering::make`).",
    enablement | AttributeId | optional | doc "`+0x38`, `enablement_resource_id` (`enabled`): the resource that enables the task, -1 none.",
    sprites | TaskSprites | doc "`+0x40`..`+0x58`: the moving, proceeding, working and carrying sprites.",
    sound_events | SoundEvents | doc "`+0x60` and `+0x78`: the event ids (`mEventId`) of the gathering and the deposit sound,\nas the task's load (`FUN_141062470`) leaves them; a terrain look task (159) names its\ndying and its undead sprite with them (`genie_core::combat::abilities`).",
  },
  TaskFlags | doc "The set's flag names joined by ` | `, unnamed bits as one hexadecimal number (`0x10`)." = String,
  TaskGroup | doc "A master's task swap group (`+0x7b8`, the `.dat`'s `TaskSwapGroup`; the save does not carry it):\na unit of a master of a group switches to another master of the same group whose task list has a\ntask for the target. 0 is none." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  TaskId | doc "A task's id ([`crate::objects::masters::Task::id`], `+0xa`, the `.dat`'s task id): 0 to 85\nin the current data ([`TaskId::of_task`]). A field that holds −1 for none holds\n`Option<TaskId>` ([`TaskId::of_field`], which rejects any other negative value)." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  TaskIndex | doc "A place in a master's task list (`default_task`, `+0x790`), which `FUN_14109e0c0` takes the\nlist's entry at; the data's −1 is none, and no negative one names a place." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 65535),
  TaskSprites | doc "A task's moving, proceeding, working and carrying sprites (`+0x40`..`+0x58`, the `.dat`'s\ngraphic ids), each None for −1." = {
    moving | SpriteId | optional | doc "`+0x40`: the sprite while it walks to its target.",
    proceeding | SpriteId | optional | doc "`+0x48`: the sprite while it comes on (an attack's swing, a repair's work).",
    working | SpriteId | optional | doc "`+0x50`: the sprite while it works.",
    carrying | SpriteId | optional | doc "`+0x58`: the sprite while it carries what it gathered.",
  },
  TaskTerrain | doc "A task's terrain (`+0x16`), every short of the data kept, −1 for none. A task finder's task\nis for the terrain its low 16 bits equal ([`TaskTerrain::is`]); a terrain look task reads it as\na flag mask (`genie_core::combat::abilities::terrain_mask`), a negative one too." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  TechDef | doc "A technology of the `.dat` as the tech tree holds it (its 0x88-byte record)." = {
    costs | Array (Cost) | doc "`+0x2a`, `+0x30`, `+0x36`: the cost entries' attributes, amounts and paid flags.",
    kind | TechKind | doc "`+0x3c`, the technology's type.",
    effect_id | EffectId | doc "Its effect (`+0x3a`) and the effect's commands (the world's effect table `+0x128`).",
    effect | Array (EffectCommand) | doc "The effect's commands.",
    required | Array (TechId) | doc "`+0x18`, `+0x24`: the technologies it requires and how many of them.",
    required_count | std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767) | doc "How many of them it requires.",
    civ | CivId | optional | doc "`+0x26`: the civ it belongs to (below 1 every civ's); `+0x28`: the game modes it is for\n(0 every one, `FUN_1413cf2f0`).",
    mode | TechMode | doc "`+0x28`: the game modes it is for (0 and 1 every one, `FUN_1413cf2f0`).",
    locations | Array (Array Dyn) | doc "`+0x70`: where it is researched, the building's master and the seconds it takes.",
  },
  TechId | doc "A technology's id (the `.dat`'s technology index, the place in a player's technologies), 0\nor more. A field that holds −1 for none holds `Option<TechId>` ([`TechId::of_field`])." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  TechKind | doc "A technology's type (its record's `+0x3c`, the `.dat`'s `type`): the tech tree's tests name\nthe shared research (0x20) and the type a disable command makes available instead (0x21);\nevery other value is a type the simulation does not tell apart." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  TechMode | doc "A technology's game modes (`+0x28`, the `.dat`'s `full_tech_mode`, a short): 0 and 1 every\none, 2 to 34 a rule, a mode or a starting age, a negative one its opposite\n([`crate::world::settings::Settings::tech_mode_allows`])." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && -32768 <= x && x <= 32767),
  TechRoles = [|  |],
  TechSlots | doc "The tech ids the engine names, one field each." = {},
  TechTree | doc "The game's tech tree table (`FUN_140c7e080`: the game object's `+0xa60`, or `+0xa68` for a\nlocal player's civilisation in `FUN_140e9a7e0`'s list, 14 and 17) by civilisation index\n(`0x20` bytes each: its buildings, count `+0x10`), and each civilisation's unique unit by its\nindex (`FUN_140e87930`, `civilizations.json`'s `unique_unit_upgrade_id`, `unique_unit_id`,\n`elite_unique_unit_id`).\n\nThe game's data load (`FUN_140c81bd0`) reads `futuravailableunits.json` into `+0xa60` and\n`paphosfutureavailableunits.json` into `+0xa68` (`FUN_1414f3720`): civilisation indices 0 to\nthe full tech tree's (`FUN_140c7e6f0`), each its name's buildings (`ID`) with their units\n(`ID`, `RequiredUnitID`, `RequiredAge`, `RequiredTechID`, `FUN_1414f5c40`), the last\n`FullTechCiv`'s. With the game's `+0x680` at 0, as genie and the tick oracle hold it, that is\nindex 0 alone: a player of civilisation 1 or more without the full tech tree finds no\ncivilisation in it, as in the empty table genie-oracle leaves; the full tech tree's index 0\nis not loaded yet." = {
    civs | Array (Array (TreeBuilding)) | doc "The civilisations' buildings.",
    unique_units | Array (UniqueUnit) | doc "The civilisations' unique units.",
  },
  TerrainId | doc "A terrain by its id: a map tile's terrain (`+0x9`), the terrain it restores (`+0xa`) and its\nlayer (`+0xc`), the index of the `.dat`'s terrain records\n(`genie_core::map::terrain::Terrain::terrains`). A master holds its terrains as shorts, −1 for\nnone ([`TerrainId::of_data`])." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  TerrainMask | doc "The terrain classes an object may stand on (its terrain restriction's, `FUN_141054630`'s\ntable): a bit per class of the obstruction manager's tile word, whose low byte holds the\ntile's class (`genie_core::map::terrain::terrain_class`); bit 7 of the word is a temporary\nrecord's." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  TerrainTuning | doc "The `terrain` port's tuning values." = {
    inside | Number | doc "`DAT_142eb1e9c`.\n\n`terrain::INSIDE`: 0.001 in build 158041.",
  },
  TilePathTuning | doc "The `tile_path` port's tuning values." = {
    early_left | Number | doc "A computer player's search stops early once a node's estimate to the goal is at most this (`DAT_14330ebb8`).\n\n`tile_path::EARLY_LEFT`: 5 in build 158041.",
    early_start | Number | doc "A computer player's search stops early only when the start's estimate to the goal is at most this (`DAT_142eb0f4c`).\n\n`tile_path::EARLY_START`: 10 in build 158041.",
    far_side | Number | doc "The hierarchical search marks 0.1 more on the square's far sides (`DAT_142eb5690`).\n\n`tile_path::FAR_SIDE`: 0.1 in build 158041.",
    goal_gap | Number | doc "The goal's own tile counts when the goal is this near it (`DAT_142eb99cc`).\n\n`tile_path::GOAL_GAP`: 0.01 in build 158041.",
    shortcut_cost | Number | doc "The level-0 search costs a turn's shortcut from the node before at 1.1 times its cost (`DAT_142e86c14`).\n\n`tile_path::SHORTCUT_COST`: 1.1 in build 158041.",
    shortcut_reach | Number | doc "The squared distance from the start within which the planner looks for a shorter first stretch (`DAT_14330ebcc`).\n\n`tile_path::SHORTCUT_REACH`: 100 in build 158041.",
    smooth_step | Number | doc "The longest step between the points the smoothing puts on a straight stretch (`DAT_142f430e8`).\n\n`tile_path::SMOOTH_STEP`: 7.5 in build 158041.",
    tile_search_length | Number | doc "The level-0 search runs only for paths shorter than this (`DAT_142f430ec`).\n\n`tile_path::TILE_SEARCH_LENGTH`: 35 in build 158041.",
  },
