  UnitAiTuning | doc "The `unit_ai` port's tuning values." = {
    armed_firepower | Number | doc "An attacker without a missile is armed with a firepower above this (`FUN_14120ea30`, `DAT_14330eb8c`).\n\n`unit_ai::ARMED_FIREPOWER`: 1 in build 158041.",
    attacker_tie | Number | doc "Two attackers' squared gaps within this of each other tie, and a draw picks one (`DAT_142ef9004`).\n\n`unit_ai::ATTACKER_TIE`: 0.0625 in build 158041.",
