    enable | std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255) | doc "The second argument's low byte (1 enables, 0 disables).",
    one | Bool | doc "The third argument is 1: the command is for one building, the effect's object.",
  }), 'Upgrade ({
