    work_rate | WorkRate | doc "`work_rate` (`+0x798`): what a builder of this master adds to the work per second.",
    search_radius | Distance | doc "`search_radius` (`+0x794`, the object's slot 0x2c8).",
    drop_sites | Array (MasterId) | doc "The `.dat`'s `drop_sites` (`+0x7a0`..`+0x7a8`, `FUN_14109d4f0`): the buildings a unit of\nthis master takes its load to.",
    run_pattern | RunPattern | doc "`+0x7b9`, `run_pattern`.",
  },
  AdjacentMode | doc "A building master's adjacent mode (`+0x980`, `adjacent_mode`): walls and gates join their\nneighbours (`FUN_1411ce890`). Every byte is kept." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0 && 0 <= x && x <= 255),
  Age | doc "An age option (`mStartingAge`, `+0x3c`, and `mEndingAge`, `+0x40`), and a tech tree unit's\nage: 0 the mode's default, 2 Feudal, 3 Castle, 4 Imperial, 5 post-Imperial, 6." = std.contract.from_predicate (fun x => std.is_number x && x % 1 == 0),
  Amount | doc "An amount of a player attribute (a resource) as the game's `f32` holds it: what an object\nholds of its attribute (`+0x310`), what a unit carries at most (its master's\n`attribute_max_amount`, [`Amount::of_master`]), what a gather, a hunt or a drop-off moves.\nEach operator is the one `f32` operation the game does, in its order; a comparison is\n`f32`'s (a NaN compares false)." = Number,
  AmountRate | doc "An amount of a player attribute per second, as the game's `f32` holds it: what a dead\nobject's remains lose of their attribute a second (a master's `resource_decay`, `+0x620`),\nnegated on the hunted target whose decay a hunt stopped. Over [`Seconds`] it is an\n[`Amount`]. Each operator is the one `f32` operation the game does, in its order; a\ncomparison is `f32`'s (a NaN compares false)." = Number,
  AnimatedPart | doc "The animated layer of a master of type 20 and up but 90 (`RGE_Master_Animated_Object`, `+0x740`;\nthe `.dat`'s `speed`, read for the types 20 and up): its top speed. An animated object (20), a\ndoppelganger (25), a moving one (30) and every type above hold it." = {
    max_speed | Speed | doc "`+0x740`, `mMaxSpeed` (the `.dat`'s `speed`): the top speed before a sprite's factor, from\nwhich [`Master::move_stats`]'s speeds and [`crate::combat::missile::MissileStats::speed`]\nfollow.",
  },
  ArcRatio | doc "A missile master's arc (the `.dat`'s `projectile_arc`, `+0x888`, the save's\n`ballistics_ratio`): 0 flies flat; else the launch makes the arc's rise of it and the way\n(`−arc × way × way` for one at most 0, `−arc × way` above)." = Number,
  ArtifactTuning | doc "The `artifact` port's tuning values." = {
